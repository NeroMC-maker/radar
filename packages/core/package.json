{
  "name": "@radar/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/client.ts",
    "./schema": "./src/db/schema.ts",
    "./load-env": "./src/load-env.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:session": "tsx src/seed/dev-session.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^5.0.1"
  }
}
