# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos. En desarrollo, `pnpm db` levanta un Postgres embebido en este puerto.
DATABASE_URL=postgres://radar:radar@127.0.0.1:54329/radar

# URL con la que el teléfono abre la aplicación.
# - Misma red Wi-Fi: http://<IP-de-tu-PC>:3100  (ej. http://192.168.1.20:3100)
# - Fuera de casa: una URL https de un túnel o del despliegue.
PUBLIC_BASE_URL=http://localhost:3100

# Telegram (REAL si hay token; si está vacío, las notificaciones se simulan en la consola del worker).
# Crea el bot con @BotFather en Telegram y pega aquí el token.
TELEGRAM_BOT_TOKEN=

# Publicación en X. Solo "simulated" está implementado en esta fase.
# El envío real queda bloqueado hasta que el propietario conecte la cuenta y lo habilite.
X_PUBLISH_MODE=simulated

# Generación de contenido. "simulated" = plantillas sin IA, marcadas como simuladas.
CONTENT_GENERATOR=simulated
# ANTHROPIC_API_KEY=   (fase 3)

# Presupuesto diario por organización (USD) antes de detener operaciones con coste.
DAILY_BUDGET_USD=2
